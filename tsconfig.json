{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "generated/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}